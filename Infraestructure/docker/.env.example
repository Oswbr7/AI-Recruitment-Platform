# =============================================================================
# AI Recruitment Platform — Docker Compose Environment
# =============================================================================
# Copia este archivo a `.env` (en ESTA misma carpeta) antes de levantar el
# stack, porque docker-compose.yaml lo lee automaticamente desde aqui:
#   cp .env.example .env
#
# El `.env` real esta en .gitignore (contiene secretos) — este archivo es la
# plantilla documentada para que un clone fresco del repo pueda arrancar.
# =============================================================================

# --- Postgres (contenedor unico, una base de datos por servicio) -------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Base de datos del auth-service (las demas se crean via init-db/*.sql)
POSTGRES_DB=recruitmentdb

# --- JWT (compartido por los 5 servicios: mismo emisor, mismo secreto) -------
# OBLIGATORIO: minimo 32 caracteres (validado con fail-fast al arrancar).
# En desarrollo se usa la clave de convenio; NUNCA reutilizarla fuera de local.
JWT_KEY=SuperSecretKeyForDevelopment123456
JWT_ISSUER=RecruitmentPlatform
JWT_AUDIENCE=RecruitmentPlatform

# --- pgAdmin (opcional, tiene defaults en el compose) -------------------------
# Nota: pgadmin rechaza TLDs como `.local` para el email — usa un dominio
# valido de mentira (ej. `.com`, `.test`).
PGADMIN_EMAIL=admin@recruitment.com
PGADMIN_PASSWORD=admin
