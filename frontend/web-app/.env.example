# =============================================================================
# AI Recruitment Platform — Frontend Environment Variables
# =============================================================================
# Copia este archivo a `.env` y ajusta los valores segun tu entorno:
#   cp .env.example .env
#
# Vite SOLO expone las variables que empiezan con VITE_ al codigo del
# navegador (import.meta.env.VITE_*) — nunca pongas secretos aqui, este
# archivo termina empaquetado en el bundle publico del frontend.
#
# Cada variable apunta al microservicio correspondiente. En desarrollo local
# con `docker compose up` (infrastructure/docker/docker-compose.yaml), los
# servicios se publican en los puertos 5000-5004 del host.
# =============================================================================

# auth-service (login/register, usuarios)
VITE_API_URL=http://localhost:5000/api

# job-service
VITE_JOBS_API_URL=http://localhost:5001/api

# candidate-service
VITE_CANDIDATES_API_URL=http://localhost:5002/api

# company-service
VITE_COMPANIES_API_URL=http://localhost:5003/api

# interview-service
VITE_INTERVIEWS_API_URL=http://localhost:5004/api
